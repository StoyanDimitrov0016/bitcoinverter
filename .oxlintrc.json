{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs", "import", "promise", "unicorn", "oxc"],
  "jsPlugins": ["./scripts/oxlint-plugin.js"],
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": ["node_modules/**", ".next/**", "out/**", "coverage/**", "scripts/**"],
  "categories": {
    "correctness": "deny",
    "suspicious": "deny"
  },
  "rules": {
    "bitcoinverter/require-component-props-type": "deny",
    "typescript/no-explicit-any": "deny",
    "typescript/no-floating-promises": "deny",
    "typescript/no-misused-promises": ["deny", { "checksVoidReturn": { "attributes": false } }],
    "typescript/no-non-null-assertion": "deny",
    "typescript/no-unsafe-argument": "deny",
    "typescript/no-unsafe-assignment": "deny",
    "typescript/no-unsafe-call": "deny",
    "typescript/no-unsafe-member-access": "deny",
    "typescript/no-unsafe-return": "deny",
    "typescript/no-unsafe-type-assertion": "deny",
    "typescript/only-throw-error": "deny",
    "typescript/promise-function-async": "deny",
    "typescript/require-await": "deny",
    "typescript/restrict-plus-operands": "deny",
    "typescript/restrict-template-expressions": ["deny", { "allowNumber": true }],
    "typescript/return-await": ["deny", "in-try-catch"],
    "typescript/switch-exhaustiveness-check": "deny",
    "typescript/await-thenable": "deny",
    "typescript/consistent-type-imports": "deny",
    "typescript/no-unused-vars": [
      "deny",
      {
        "args": "all",
        "caughtErrors": "all",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": false
      }
    ],
    "react/rules-of-hooks": "deny",
    "react/exhaustive-deps": "deny",
    "react/jsx-key": "deny",
    "react/no-danger": "deny",
    "react/no-unstable-nested-components": "deny",
    "react/only-export-components": "allow",
    "react/jsx-filename-extension": "allow",
    "react/jsx-no-literals": "allow",
    "react/no-multi-comp": "allow",
    "react/react-in-jsx-scope": "allow",
    "nextjs/no-img-element": "deny",
    "nextjs/no-async-client-component": "deny",
    "nextjs/no-before-interactive-script-outside-document": "deny",
    "nextjs/no-css-tags": "deny",
    "nextjs/no-document-import-in-page": "deny",
    "nextjs/no-duplicate-head": "deny",
    "nextjs/no-head-element": "deny",
    "nextjs/no-script-component-in-head": "deny",
    "nextjs/no-sync-scripts": "deny",
    "nextjs/no-title-in-document-head": "deny",
    "nextjs/inline-script-id": "deny",
    "nextjs/google-font-display": "deny",
    "nextjs/google-font-preconnect": "deny",
    "nextjs/no-page-custom-font": "deny",
    "import/first": "deny",
    "import/newline-after-import": "deny",
    "import/no-duplicates": "deny",
    "import/no-default-export": "allow",
    "import/no-named-export": "allow",
    "import/no-unassigned-import": "allow",
    "no-console": "deny",
    "no-debugger": "deny",
    "no-nested-ternary": "deny",
    "no-duplicate-imports": "deny",
    "no-promise-executor-return": "deny",
    "no-self-compare": "deny",
    "no-template-curly-in-string": "deny",
    "no-useless-computed-key": "deny",
    "no-useless-return": "deny",
    "object-shorthand": "deny",
    "prefer-const": "deny",
    "prefer-object-has-own": "deny",
    "prefer-regex-literals": "deny",
    "eqeqeq": ["deny", "always", { "null": "ignore" }],
    "curly": ["deny", "all"],
    "radix": "deny"
  }
}
